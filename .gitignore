# ============================================================
#  Secrets - NEVER commit any of these
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
*secret*
*credential*
secrets/
config.local.*
config.*.yaml

# ============================================================
#  Raw / intermediate data (contains reviewer names -> PII)
# ============================================================
data/raw/
data/interim/
data/*.csv
!data/desensitized/
!data/desensitized/*.csv

# ============================================================
#  Model weights & training outputs
#  Large training artifacts stay OUT of git. The final RELEASED
#  weights are committed on purpose (see models/README.md):
#    models/bilstm_model.pt
#    models/qwen_adapter_final/adapter_model.safetensors
#  Negation rules must come AFTER the ignore rules to work.
# ============================================================
*.pt
*.pth
*.safetensors
*.bin
*.ckpt
*.onnx
*.gguf
checkpoints/
outputs/
lora_adapter/
results/figures/*.png

# Explicitly released model artifacts (do not remove these negations)
!models/bilstm_model.pt
!models/qwen_adapter_final/*.safetensors

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ============================================================
#  Misc
# ============================================================
.DS_Store
*.log
Thumbs.db
