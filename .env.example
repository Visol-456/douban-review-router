# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored - it must NEVER be committed.

# DeepSeek / OpenAI-compatible endpoint (used for weak labeling + deep analysis)
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Model used for DeepSeek server-side web_search (Responses API); optional
# DEEPSEEK_SEARCH_MODEL=deepseek-v4-pro

# Metaso (秘塔) search key — optional, fallback web search in the agent layer
# METASO_API_KEY=***

# Optional: override where data is read/written (defaults to ./data)
# DRR_DATA_ROOT=/absolute/path/to/data
